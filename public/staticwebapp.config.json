{
  "trailingSlash": "never",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      }
    },
    {
      "route": "/ads.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".xml": "application/xml",
    ".txt": "text/plain"
  }
}